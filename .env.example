# Copy this file to .env and fill in your keys. Never commit the real .env.

# Which LLM backend to use at startup: "ollama" (local, free, private),
# "anthropic" (hosted, costs money, much stronger tool-calling), or "gemini"
# (hosted, free tier with no billing/card required — a good zero-cost
# bridge to a stronger-than-local model). All three are switchable live
# from the UI's model switcher regardless of this startup default.
LLM_PROVIDER=ollama

# Only required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ASSISTANT_MODEL=claude-sonnet-4-6

# Only required when LLM_PROVIDER=gemini. Free key, no billing needed:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# gemini-3.6-flash, not the newer 3.7 — 3.7-flash's free tier is capped at
# just 20 requests/day (confirmed live), too tight for real use.
GEMINI_MODEL=gemini-3.6-flash

# Only used when LLM_PROVIDER=ollama. Must already be pulled locally
# (ollama pull qwen2.5:7b). Sets the model active at startup — from there,
# the UI's model switcher (top bar) can swap between qwen2.5:7b, llama3.1:latest,
# gemma2:9b, Anthropic, and Gemini on the fly (see AVAILABLE_MODELS in
# config.py). Local switches still require the target model to already be
# pulled (e.g. ollama pull llama3.1).
OLLAMA_MODEL=qwen2.5:7b

# How long Ollama keeps a model loaded in memory after the last request
# (Ollama's own default is only 5 minutes). On CPU-only hardware, reloading
# a multi-GB model from disk costs 10+ seconds on top of inference time, so
# this keeps it warm across a realistic session gap instead of paying that
# reload cost repeatedly. Format: "30m", "1h", "-1" (never unload), "0"
# (unload immediately after each request).
OLLAMA_KEEP_ALIVE=30m

ASSISTANT_NAME=TEJAS

# Optional — enables the web_search tool. Free tier at https://tavily.com
SEARCH_API_KEY=tvly-your-key-here

# Which speech-to-text backend powers voice input (the mic button):
# "local" (faster-whisper, offline, free — default) or "openai" (hosted
# Whisper API, needs OPENAI_API_KEY). "openai" automatically falls back to
# local on any failure, so voice input keeps working either way.
STT_PROVIDER=local

# Only used when STT_PROVIDER=local. Bigger models are more accurate but
# slower/heavier: tiny.en < base.en < small.en < medium.en. small.en is a
# meaningfully more accurate default than base.en for near-identical local
# latency on most machines — bump to medium.en only if you still see
# mis-transcriptions.
WHISPER_MODEL=small.en

# Only required when STT_PROVIDER=openai.
OPENAI_API_KEY=sk-your-key-here
OPENAI_STT_MODEL=whisper-1

# Which text-to-speech backend powers voice output (spoken replies):
# "neural" (Kokoro-82M, GPU-accelerated via CUDA when available, default) or
# "browser" (disable server-side TTS; the frontend's built-in browser voice
# handles it instead, as it always did before this existed). "neural" also
# falls back to the browser voice automatically at runtime if torch/kokoro
# aren't installed or fail to load — see README.md for the required CUDA
# torch install step (a plain `pip install torch` gets you a CPU-only build).
TTS_PROVIDER=neural
# Startup default voice — switchable live from the UI's voice selector (top
# bar / Voice Mode) between the 3 presets in AVAILABLE_TTS_VOICES
# (config.py): am_michael/am_fenrir (male), af_heart (female, the
# highest-quality voice overall). Any other Kokoro voice name also works
# here even if it's not in that preset list — see the full voice pack at
# https://huggingface.co/hexgrad/Kokoro-82M — it just won't show as a
# clickable option in the UI.
TTS_VOICE=am_michael
# Kokoro language/voice-pack prefix — "a" = American English. Must match
# TTS_VOICE's prefix (af_/am_ both use "a").
TTS_LANG_CODE=a